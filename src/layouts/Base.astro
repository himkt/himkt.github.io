---
import '../styles/global.css';

const {
  title = 'himkt - Portfolio',
  description = 'Portfolio of himkt (Makoto Hiramatsu): software engineering, machine learning, and natural language processing.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-zinc-50 text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-200">
    <slot />
  </body>
</html>
