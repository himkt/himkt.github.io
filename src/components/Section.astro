---
const { id, title, subtitle } = Astro.props;
---

<section id={id} class="mx-auto w-full max-w-6xl px-6 py-14">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h2>
  {subtitle && <p class="mt-2 text-zinc-600 dark:text-zinc-400">{subtitle}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
