---
import { Icon } from 'astro-icon/components';
import { profile } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800">
  <div class="mx-auto w-full max-w-6xl space-y-6 px-6 py-16 text-center text-sm text-zinc-500 dark:text-zinc-400">
    <p>Copyright © {year} {profile.name} (@{profile.handle}). All rights reserved.</p>
    <nav aria-label="Profile links" class="flex items-center justify-center gap-3">
      {
        profile.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noreferrer"
            title={link.label}
            class="flex h-10 w-10 items-center justify-center rounded-full border border-zinc-300 text-zinc-500 transition hover:border-sky-500 hover:text-sky-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-sky-400 dark:hover:text-sky-400"
          >
            <Icon name={link.icon} class="h-4.5 w-4.5" />
            <span class="sr-only">{link.label}</span>
          </a>
        ))
      }
    </nav>
    <p>
      Built with{' '}
      <a
        href="https://astro.build"
        target="_blank"
        rel="noreferrer"
        class="text-sky-600 hover:underline dark:text-sky-400"
      >
        Astro
      </a>
      — the web framework for content-driven websites.
    </p>
  </div>
</footer>
